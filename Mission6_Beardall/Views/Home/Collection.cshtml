@{
}
@model List<Movie>

<table class="table table-striped table-bordered text-center mt-4 shadow-lg">
    <thead class="table-dark">
        <tr>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Copied to Plex</th>
            <th>Notes</th>
            <th>Actions</th> <!-- Merged Edit/Delete into one column -->
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@(movie.Category != null ? movie.Category.CategoryName : "N/A")</td>
                <td>@(string.IsNullOrEmpty(movie.Title) ? "N/A" : movie.Title)</td>
                <td>@movie.Year</td>
                <td>@(string.IsNullOrEmpty(movie.Director) ? "N/A" : movie.Director)</td>
                <td>@(string.IsNullOrEmpty(movie.Rating) ? "N/A" : movie.Rating)</td>
                <td>@(movie.Edited ? "Yes" : "No")</td>
                <td>@(string.IsNullOrEmpty(movie.LentTo) ? "N/A" : movie.LentTo)</td>
                <td>@movie.CopiedToPlex</td>
                <td>@(string.IsNullOrEmpty(movie.Notes) ? "N/A" : movie.Notes)</td>
                <td>
                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieID" class="btn btn-outline-info btn-sm">Edit</a>
                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
