@{
}
@model Mission6_Beardall.Models.Movie

<div class="text-center">
    <h2>Suggest a Film</h2>

    <form method="post">
        <!-- Category (Dropdown Selection) -->
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" class="form-control" required asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
            <option value="">-- Select a Category --</option>
        </select>
        <br>

        <!-- Title (Required) -->
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required>
        <br>

        <!-- Year (Required) -->
        <label asp-for="Year"></label>
        <input asp-for="Year" type="number" class="form-control" required>
        <br>

        <!-- Director (Required) -->
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" required>
        <br>

        <!-- Rating (Dropdown) -->
        <label asp-for="Rating"></label>
        <select asp-for="Rating" class="form-control" required>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
        <br>

        <!-- Edited (Yes/No) -->
        <label asp-for="Edited"></label>
        <div>
            <input asp-for="Edited" type="radio" value="true"> Yes
            <input asp-for="Edited" type="radio" value="false"> No
        </div>
        <br>

        <!-- Lent To (Optional) -->
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control">
        <br>

        <!-- Copied To Plex (Optional) -->
        <label asp-for="CopiedToPlex"></label>
        <input asp-for="CopiedToPlex" class="form-control">
        <br>

        <!-- Notes (Optional, Max 25 Characters) -->
        <label asp-for="Notes"></label>
        <input asp-for="Notes" class="form-control" maxlength="25">
        <br>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">Submit Film</button>
    </form>
</div>
