@{
}
@model Movie

<h2>Delete Movie</h2>

<h3>Are you sure you want to delete the movie titled "@Model.Title"?</h3>

<form method="post">
    <input type="hidden" asp-for="MovieID" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a href="@Url.Action("Collection")" class="btn btn-secondary">Cancel</a>
</form>
